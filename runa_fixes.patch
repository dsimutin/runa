+"""Traditional / etymological rune meanings — Elder Futhark.
+
+Separate, optional layer shown only on request (the 'ℹ️ О руне' button),
+deliberately kept OUT of the main reading flow. The main bot voice is
+psychological/coaching, not mythological — mixing the two registers in
+the same message reads as inconsistent. This module gives the classic
+context to people who explicitly ask for it, without changing the tone
+of readings themselves.
+
+Each entry: element/idea in one line, then 2-3 sentences of traditional
+meaning (Old Norse/Old English source name, common attested associations).
+Deliberately factual and brief — this is reference material, not a reading.
+"""
+
+from typing import Dict
+
+TRADITIONAL_MEANINGS: Dict[str, str] = {
+    "fehu": (
+        "Стихия/идея: скот, движимое богатство.\n\n"
+        "Древнейший смысл — домашний скот как мера состояния в дописьменную эпоху: "
+        "богатство, которое можно перегнать, потерять или пустить в оборот. "
+        "Традиционно связывается с достатком, начальным капиталом и тем, что заработано, "
+        "а не унаследовано."
+    ),
+    "uruz": (
+        "Стихия/идея: тур (дикий бык), первобытная сила.\n\n"
+        "Названа в честь тура — вымершего дикого быка, символа необузданной физической мощи "
+        "и выносливости. Традиционно означает жизненную силу, здоровье и волю, "
+        "которую невозможно приручить до конца."
+    ),
+    "thurisaz": (
+        "Стихия/идея: великан, шип, Тор.\n\n"
+        "Связана с великанами (турсами) в скандинавской мифологии и молотом Тора как оружием "
+        "защиты от них. Традиционно символ разрушительной, но и защитной силы — "
+        "конфликта, который расчищает пространство."
+    ),
+    "ansuz": (
+        "Стихия/идея: бог, речь, Один.\n\n"
+        "Связана с Одином — богом мудрости, магии и красноречия. "
+        "Традиционно символизирует слово, вдохновение, послание свыше "
+        "и силу, которую несёт правильно сказанная речь."
+    ),
+    "raido": (
+        "Стихия/идея: путешествие верхом, колесо.\n\n"
+        "Буквально означает «езда» — путешествие по дороге, часто ритуальное или обрядовое. "
+        "Традиционно связана с движением, путём как таковым и порядком, "
+        "который требуется, чтобы путь был пройден благополучно."
+    ),
+    "kenaz": (
+        "Стихия/идея: факел, язва/огонь.\n\n"
+        "В разных традициях толкуется и как «свет, знание», и как «болезненный нарыв» — "
+        "то есть огонь, который освещает, но и причиняет боль при контакте. "
+        "Символ ремесла, мастерства и знания, добытого через контролируемый огонь."
+    ),
+    "gebo": (

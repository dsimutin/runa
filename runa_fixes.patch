+def get_person_text(rune_key: str, palette: str) -> str:
+    key = (rune_key or "").strip().lower()
+    entry = PERSON_TEXTS.get(key)
+    if not entry:
+        return ""
+    return entry.get(palette) or entry.get("light", "")

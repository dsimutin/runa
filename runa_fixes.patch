+    prefix = "Да." if is_yes else "Нет."
+    if not text.startswith(prefix):
+        return text
+    pool = YES_OPENERS if is_yes else NO_OPENERS
+    rest = text[len(prefix):]
+    return random.choice(pool) + rest

# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to run admin-only commands.
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# false = free template mode, true = OpenAI mode for /rasklad
USE_GPT=false

# Required only if USE_GPT=true
OPENAI_API_KEY=

# Requested model. You may replace it if your OpenAI account uses another available model.
OPENAI_MODEL=gpt-3.5-turbo

# SQLite database path. Use a persistent disk path in production if your host supports it.
DB_PATH=rune_bot.db

# Optional: if set, the bot starts in webhook mode. If empty, polling mode is used.
# Example: WEBHOOK_URL=https://telegram-rune-oracle-bot.onrender.com
WEBHOOK_URL=

# Public webhook path. Keep this value boring and never put BOT_TOKEN here.
WEBHOOK_PATH=webhook

# Render usually provides PORT automatically. Local fallback:
PORT=10000

# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# false = free template mode, true = OpenAI mode for /rasklad
USE_GPT=false

# Required only if USE_GPT=true
OPENAI_API_KEY=

# Requested model. You may replace it if your OpenAI account uses another available model.
OPENAI_MODEL=gpt-3.5-turbo

# SQLite database path
DB_PATH=rune_bot.db

# For Render webhook mode only, for example:
# WEBHOOK_URL=https://telegram-rune-oracle-bot.onrender.com
WEBHOOK_URL=

# Render usually provides PORT automatically. Local fallback:
PORT=10000
